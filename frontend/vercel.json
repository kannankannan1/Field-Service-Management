{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*": {
      "runtime": "nodejs20"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/ws/(.*)", "destination": "/ws/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
# Backend API URL for the frontend.
# In local development set this to your local backend, e.g. http://localhost:5000
# In production (Vercel) set this to your deployed backend domain, e.g. https://your-backend.vercel.app
# Leave blank to use a relative /api path (only if you run behind a proxy on the same origin).
VITE_API_URL=http://localhost:5000

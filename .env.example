# ============================================================
# Root .env.example — copy to .env and fill in your values
# ============================================================

# ----- FRONTEND (Vercel) -----
# Set in Vercel dashboard: Settings → Environment Variables
VITE_API_URL=https://your-backend.up.railway.app

# ----- BACKEND (Railway / Render) -----
# Set these in your backend host's environment settings

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secrets — generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=your-access-secret
REFRESH_TOKEN_SECRET=your-refresh-secret

# Allowed frontend origin(s) — comma-separated
CORS_ORIGIN=https://your-frontend.vercel.app

# Port (set automatically by Railway/Render — do not override)
PORT=8080

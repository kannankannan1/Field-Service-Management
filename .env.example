# ============================================================
# Root .env.example — reference for environment variables.
# Copy values into your actual environment (local .env files or
# Vercel dashboard). Do NOT commit real secrets.
# ============================================================

# ----- FRONTEND (Vercel / local /frontend/.env) -----
# Set in Vercel dashboard: Settings → Environment Variables
VITE_API_URL=https://your-backend-domain.vercel.app
# Local dev value:
# VITE_API_URL=http://localhost:5000

# ----- BACKEND (Vercel / local /api/.env) -----
# Set these as secrets in the backend's environment settings.

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secrets — generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=your-access-secret
REFRESH_TOKEN_SECRET=your-refresh-secret

# Allowed frontend origin(s) — comma-separated
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Local HTTP port (Vercel sets this automatically)
PORT=5000

# Environment: development | production
NODE_ENV=development

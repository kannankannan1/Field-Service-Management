# ---- Keystone Express backend ----

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secrets — generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Comma-separated allowed browser origins (your Vercel frontend URL)
CORS_ORIGIN=https://your-frontend.vercel.app

# Port (Railway/Render set this automatically)
PORT=8080

# ---- Keystone Express backend ----
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file — keep secrets out of version control.

# Supabase project URL (from Supabase dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secrets — generate strong values with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Comma-separated allowed browser origins (your Vercel frontend URL).
# Local dev defaults are applied automatically if this is empty.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Port for local `npm start` / `npm run dev` (Vercel sets this automatically)
PORT=5000

# Environment: development | production
NODE_ENV=development
